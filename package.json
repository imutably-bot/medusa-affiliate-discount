{
  "name": "@rsc-labs/medusa-affiliate-discount",
  "version": "0.2.0",
  "description": "Create affiliate discount to promote your products",
  "author": "RSC Labs (https://rsoftcon.com)",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/RSC-Labs/medusa-affiliate-discount"
  },
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    "./package.json": "./package.json",
    "./admin": "./dist/admin/index.js"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "keywords": [
    "medusa-plugin",
    "medusa-plugin-other",
    "medusa-v2",
    "admin",
    "affiliate marketing",
    "affiliate discount",
    "discount"
  ],
  "scripts": {
    "clean": "cross-env ./node_modules/.bin/rimraf dist",
    "build": "cross-env npm run clean && tsc -p tsconfig.json",
    "build:server": "cross-env npm run clean && tsc -p tsconfig.json",
    "build:admin": "cross-env tsc -p tsconfig.json",
    "prepare": "cross-env NODE_ENV=production npm run build:server"
  },
  "dependencies": {
    "@medusajs/admin-sdk": "2.8.5",
    "@medusajs/framework": "2.8.5",
    "@medusajs/icons": "^1.2.2",
    "@medusajs/ui": "^4.0.6",
    "@tanstack/react-query": "^4.22",
    "medusa-core-utils": "^1.2.3",
    "react-hook-form": "^7.49.2",
    "typeorm": "^0.3.16",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@babel/cli": "^7.14.3",
    "@babel/core": "^7.14.3",
    "@medusajs/medusa": "2.8.5",
    "@types/express": "^4.17.13",
    "babel-preset-medusa-package": "^1.1.19",
    "cross-env": "^7.0.3",
    "eslint": "^6.8.0",
    "rimraf": "^3.0.2",
    "ts-node": "^10.9.2",
    "typescript": "^5.0.0"
  },
  "peerDependencies": {
    "@medusajs/medusa": "^2.8.5",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-router-dom": "^6.13.0"
  },
  "jest": {
    "globals": {
      "ts-jest": {
        "tsconfig": "tsconfig.spec.json"
      }
    },
    "moduleFileExtensions": [
      "js",
      "json",
      "ts"
    ],
    "testPathIgnorePatterns": [
      "/node_modules/",
      "<rootDir>/node_modules/"
    ],
    "rootDir": "src",
    "testRegex": "(/__tests__/.*|\\.(test|spec))\\.(ts|js)$",
    "transform": {
      ".ts": "ts-jest"
    },
    "collectCoverageFrom": [
      "**/*.(t|j)s"
    ],
    "coverageDirectory": "./coverage",
    "testEnvironment": "node"
  }
}
